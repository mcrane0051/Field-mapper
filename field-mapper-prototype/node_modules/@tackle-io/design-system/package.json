{
  "name": "@tackle-io/design-system",
  "version": "0.0.1-alpha.7",
  "description": "Tackle Design System - React components built from Figma designs",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./tokens": {
      "import": "./tokens/index.ts",
      "types": "./tokens/types.ts"
    },
    "./styles": {
      "import": "./dist/index.css",
      "types": "./tokens/styles.d.ts"
    }
  },
  "bin": {
    "design-system": "./bin/cli.mjs"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com/",
    "tag": "alpha"
  },
  "files": [
    "dist",
    "tokens",
    "bin",
    "template",
    "templates",
    "README.md",
    "skills/tackle-design-system",
    "skills/tackle-content-style",
    "skills/tackle-accessibility"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "prepublishOnly": "npm run build",
    "setup": "npm install && npm run skills:install",
    "skills:install": "npx --yes skills@latest add ./skills -y && npx --yes skills@latest add ./skills-internal -y",
    "prepare": "npm run skills:install --silent || echo 'WARN: skills install skipped (vercel-labs/skills CLI unavailable or failed). Run `npm run skills:install` manually to retry.'"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^8.6.18",
    "@storybook/addon-essentials": "^8.6.18",
    "@storybook/addon-interactions": "^8.6.18",
    "@storybook/addon-links": "^8.6.18",
    "@storybook/blocks": "^8.6.18",
    "@storybook/react": "^8.6.18",
    "@storybook/react-vite": "^8.6.18",
    "@storybook/test": "^8.6.18",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/ui": "^2.1.9",
    "axe-core": "^4.11.3",
    "eslint": "^9.39.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.0",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-storybook": "^0.11.1",
    "jsdom": "^25.0.1",
    "prettier": "^3.8.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "storybook": "^8.6.18",
    "typescript": "~5.9.0",
    "vite": "^6.4.2",
    "vitest": "^2.1.9",
    "vitest-axe": "^0.1.0"
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "overrides": {
    "@testing-library/dom": "10.3.2"
  },
  "keywords": [
    "design-system",
    "react",
    "components",
    "tackle",
    "figma",
    "typescript",
    "tanstack-intent"
  ],
  "author": "Tackle.io Design Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tackle-io/design-system"
  }
}
